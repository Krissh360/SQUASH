            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Payment gateway timeout\",\n  \"description\": \"Stripe API hangs for 30 seconds on checkout.\",\n  \"severity\": \"CRITICAL\",\n  \"priority\": \"P1\",\n  \"reporter\": \"Alice\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/issues",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "issues"
          ]
        }
      }
    },
